# Copy to .env (repo root) and adjust. The Go server reads it on start.

# --- Claude (optional) -------------------------------------------------------
# Without a key the app still OCRs locally and offers full-text search.
# With a key it also extracts metadata, answers questions, and can re-read weak
# scans with Claude vision.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Server-side refusal fallbacks are on by default; set to 0 to turn them off.
# CLAUDE_FALLBACKS=0

# --- OCR ---------------------------------------------------------------------
# local  = only the local worker; documents never leave this machine for OCR
# claude = always Claude vision
# auto   = local first, Claude vision when the local result is weak (needs a key)
OCR_MODE=auto
OCR_MIN_CONFIDENCE=0.85
OCR_MAX_WEAK_RATIO=0.05
OCR_WORKER_URL=http://127.0.0.1:8001

# --- Server ------------------------------------------------------------------
ADDR=:8080
DATABASE_URL=postgres://localhost:5432/docdoctor?sslmode=disable
DATA_DIR=./data
# Set to 1 when serving over HTTPS.
COOKIE_SECURE=
